NODE_ENV=development

BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
PORT=5000

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database — replace with your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/distributed_file_storage
MONGODB_DATABASE=distributed_file_storage

# ============================================================
# SECRETS — REPLACE ALL VALUES BEFORE PRODUCTION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

ENCRYPTION_KEY=

# Shared secret for backend <-> storage node authentication
INTERNAL_API_SECRET=

# ============================================================
# STORAGE
# ============================================================
STORAGE_ROOT=D:/DistributedStorage

STORAGE_NODE_1_URL=http://localhost:5001
STORAGE_NODE_2_URL=http://localhost:5002
STORAGE_NODE_3_URL=http://localhost:5003
STORAGE_NODE_4_URL=http://localhost:5004

# ============================================================
# FILE PROCESSING
# ============================================================
CHUNK_SIZE_MB=10
REPLICATION_FACTOR=2
PARALLEL_DOWNLOADS=2

# ============================================================
# HEARTBEAT / MONITORING
# ============================================================
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000

STORAGE_REQUEST_TIMEOUT_MS=10000
STORAGE_UPLOAD_TIMEOUT_MS=60000
STORAGE_HEALTH_TIMEOUT_MS=5000

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info

# ============================================================
# RESEARCH MODE
# ============================================================
RESEARCH_MODE=false
REEVALUATION_COOLDOWN_MS=60000
LOAD_THRESHOLD=0.8
LATENCY_THRESHOLD_MS=100
CAPACITY_THRESHOLD_PERCENT=0.9
MIN_MIGRATION_BENEFIT=0.1

# Placement weights (sum should be ~1.0)
WEIGHT_PERFORMANCE=0.3
WEIGHT_LOAD_BALANCE=0.25
WEIGHT_LATENCY=0.2
WEIGHT_RELIABILITY=0.15
WEIGHT_REPLICA_DIVERSITY=0.1
WEIGHT_ADAPTATION_COST=0.3
